VK_ACCESS_TOKEN=replace-with-vk-user-token
VK_TARGET_PEER_ID=2000000123
TELEGRAM_BOT_TOKEN=replace-with-telegram-bot-token
TELEGRAM_TARGET_CHAT_ID=-1001234567890
VK_BLOCKED_SENDER_IDS=
DRY_RUN=true
DEBUG=false
# Optional full VK message metadata (adds getById for accepted plain messages).
VK_FETCH_FULL_MESSAGES=false
STATE_DB_PATH=state/vk2tg.sqlite
# Optional observers: PLUGINS=example,metrics
PLUGINS=
PLUGIN_TIMEOUT_SECONDS=10
# Used only by the metrics observer; compose.metrics.yaml overrides this inside Docker.
METRICS_LISTEN_ADDR=127.0.0.1:9091
# Host-only port published by compose.metrics.yaml; change if 9091 is occupied.
METRICS_HOST_PORT=9091
